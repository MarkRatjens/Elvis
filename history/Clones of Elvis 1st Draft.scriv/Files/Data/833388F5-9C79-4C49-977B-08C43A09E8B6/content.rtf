\par\pard\plain \sa240\sb360\ltrch\loch {\f1\fs48\b1\cf1 The atomic bombing of Hiroshima and its effect on people}
\par\pard\plain \sa240\sb240\ltrch\loch {\f2\fs24\b0\cf1 AFP-JIJI}
