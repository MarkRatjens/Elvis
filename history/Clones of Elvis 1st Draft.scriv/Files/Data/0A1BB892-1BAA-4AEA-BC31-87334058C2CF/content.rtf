\f0\b\fs44 \cf0 The wave nature of simple gravitational waves 
\f1\b0\fs24 \
\pard\pardeftab720\sb160\partightenfactor0

\f2\fs22 \cf0 An article by
\f1\fs24 \
\pard\pardeftab720\partightenfactor0
{\field{\*\fldinst{HYPERLINK "http://www.einstein-online.info/spotlights/gw_waves#author"}}{\fldrslt 
\f2\fs22 \cf2 \ul \ulc0 Markus P\'f6ssel}}
\f2\fs22  
\f1\fs24 \
\pard\pardeftab720\partightenfactor0

