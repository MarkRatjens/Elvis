\f1\b \cf0 21 Dec \'97 Bunker Ultimatum
\f0\b0 \cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Sharpen Chip\'92s safety conflict.\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Chip\'92s authority; clash with Johnny/Sages; pressure to continue.\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
