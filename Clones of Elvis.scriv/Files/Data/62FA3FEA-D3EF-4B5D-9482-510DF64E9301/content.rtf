\pard\intbl\itap1\pardeftab720\partightenfactor0

\f2\b0 \cf0 Janine has thought the proposition through before speaking.\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Janine is still deciding what sort of mother she is prepared to be while she talks. She cries, judges herself, then proceeds anyway.\cell 
\pard\intbl\itap1\pardeftab720\partightenfactor0
\cf0 Characters need not arrive psychologically resolved just because the plot requires them to act.\cell \row

\itap1\trowd \taflags0 \trgaph108\trleft-108 \trbrdrl\brdrnil \trbrdrr\brdrnil 
\clvertalc \clshdrawnil \clwWidth4341\clftsWidth3 \clmart10 \clmarl10 \clmarb10 \clmarr10 \clbrdrt\brdrnil \clbrdrl\brdrnil \clbrdrb\brdrnil \clbrdrr\brdrnil \clpadt20 \clpadl20 \clpadb20 \clpadr20 \gaph\cellx2880
