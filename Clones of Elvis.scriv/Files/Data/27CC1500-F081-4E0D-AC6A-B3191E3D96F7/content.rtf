\ls4\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 		\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 This is the point where their route stops feeling like movement through forest and briefly becomes movement above an enormous map. {\field{\*\fldinst{HYPERLINK "https://mntviews.blogspot.com/2016/04/gladstone-lindeman-copeland-passes-nsw.html?utm_source=chatgpt.com"}}{\fldrslt \cf3 \ul \ulc3 \strokec3 Mnt Views}}\
