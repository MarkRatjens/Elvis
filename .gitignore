# macOS
.DS_Store

# Scrivener transient state — regenerated by the app, churns on every
# autosave while a project is open. The .scrivx and Files/Data are the
# real project and are tracked.
user.lock
*.scriv/Files/search.indexes
*.scriv/Files/binder.autosave
*.scriv/QuickLook/

# Obsidian per-machine workspace state
.obsidian/workspace.json

# Claude Code machine-local settings
.claude/settings.local.json
